
@model Warehouse_25DH110249.Models.Product
@{
    ViewBag.Title = "Câu 2b - Chỉnh sửa sản phẩm";
}

<h3 class="text-primary font-weight-bold mb-3">Câu 2b: Chỉnh sửa thông tin sản phẩm</h3>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="card p-4 col-md-7 shadow-sm">
        <div class="form-group">
            <label class="font-weight-bold">Mã sản phẩm (Không thể sửa):</label>
            @Html.TextBoxFor(m => m.ProductID, new { @class = "form-control bg-light", @readonly = "readonly" })
        </div>
        <div class="form-group">
            <label class="font-weight-bold">Số lượng tồn kho (Không thể sửa):</label>
            @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control bg-light", @readonly = "readonly" })
        </div>
        <div class="form-group">
            <label class="font-weight-bold">Tên sản phẩm (*):</label>
            @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger font-weight-bold" })
        </div>
        <div class="form-group">
            <label class="font-weight-bold">Danh mục (*):</label>
            @Html.TextBoxFor(m => m.Category, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger font-weight-bold" })
        </div>
        <div class="form-group">
            <label class="font-weight-bold">Đơn giá mới (*):</label>
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01" })
            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger font-weight-bold" })
        </div>
        <div class="mt-2">
            <button type="submit" class="btn btn-primary font-weight-bold px-4">Lưu cập nhật</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary px-4">Hủy bỏ</a>
        </div>
    </div>
}